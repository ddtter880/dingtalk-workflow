# ==================== 前端环境变量（VITE_ 前缀） ====================

# 钉钉企业ID
VITE_DINGTALK_CORP_ID=你的企业CorpId

# 钉钉应用AgentId（用于工作通知）
VITE_DINGTALK_AGENT_ID=你的应用AgentId

# 钉钉应用AppKey（前端仅用于标识，不涉及敏感操作）
VITE_DINGTALK_APP_KEY=你的应用AppKey

# 钉钉群机器人Webhook（用于群消息推送）
VITE_DINGTALK_ROBOT_WEBHOOK=你的机器人Webhook地址

# 钉钉在线表格ID
VITE_DINGTALK_SHEET_ID=你的在线表格ID

# ==================== 后端环境变量（Vercel环境变量配置） ====================
# 以下变量仅在Vercel服务端使用，不要添加VITE_前缀

# 钉钉应用凭证（服务端专用）
DINGTALK_APP_KEY=你的应用AppKey
DINGTALK_APP_SECRET=你的应用AppSecret

# 钉钉企业ID（服务端）
DINGTALK_CORP_ID=你的企业CorpId

# 钉钉应用AgentId（服务端，用于工作通知）
DINGTALK_AGENT_ID=你的应用AgentId

# 钉钉在线表格ID（服务端）
DINGTALK_SHEET_ID=你的在线表格ID

# ==================== OA审批配置 ====================

# 审批模板编码（在钉钉OA审批管理后台获取）
DINGTALK_PROCESS_CODE=你的审批模板编码
